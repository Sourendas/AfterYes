# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Hosted app URL.
APP_URL="MY_APP_URL"

# Public GA4 id for the browser tag (optional).
VITE_GA_MEASUREMENT_ID=""

# Server-side tracking (set these in Vercel Project Settings → Environment Variables).
# GA4 Measurement Protocol — Admin → Data streams → Measurement Protocol API secrets
GA_MEASUREMENT_ID="G-XXXXXXXXXX"
GA_API_SECRET=""

# Optional destination for every server event (Zapier / Make / n8n).
TRACK_WEBHOOK_URL=""

# Optional Zapier / Make / n8n destination for completed onboarding configs.
VITE_ONBOARDING_WEBHOOK_URL=""
